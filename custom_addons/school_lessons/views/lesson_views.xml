<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================== Form View ==================== -->
        <record id="view_school_lesson_form" model="ir.ui.view">
            <field name="name">school.lesson.form</field>
            <field name="model">school.lesson</field>
            <field name="arch" type="xml">
                <form string="حصة دراسية">
                    <header>
                        <button name="action_publish" string="نشر الحصة"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_set_draft" string="رجوع لمسودة"
                                type="object"
                                invisible="state != 'published'"/>
                        <button name="action_archive_lesson" string="أرشفة"
                                type="object"
                                invisible="state == 'archived'"/>
                        <button name="action_view_students_progress" string="مين شاف الحصة؟"
                                type="object" class="btn-secondary"
                                invisible="state != 'published'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,published"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_students_progress" icon="fa-eye"
                                    invisible="state != 'published'">
                                <field name="students_viewed" widget="statinfo" string="شاهدوا"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="مثال: الدرس الأول - قواعد اللغة"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="class_id"/>
                                <field name="subject_id"/>
                                <field name="teacher_id"/>
                            </group>
                            <group>
                                <field name="lesson_type"/>
                                <field name="video_url" invisible="lesson_type not in ('video_link','mixed')"/>
                                <field name="date_published"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="الملفات (PDF / فيديو مرفوع)">
                                <field name="attachment_ids" widget="many2many_binary"
                                       string="ارفع الملفات هنا"/>
                            </page>
                            <page string="الوصف">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ==================== List View ==================== -->
        <record id="view_school_lesson_list" model="ir.ui.view">
            <field name="name">school.lesson.list</field>
            <field name="model">school.lesson</field>
            <field name="arch" type="xml">
                <list string="الحصص الدراسية" default_order="sequence, date_published desc">
                    <field name="name"/>
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="teacher_id"/>
                    <field name="lesson_type"/>
                    <field name="date_published"/>
                    <field name="students_viewed"/>
                    <field name="students_total"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'published'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <!-- ==================== Kanban View ==================== -->
        <record id="view_school_lesson_kanban" model="ir.ui.view">
            <field name="name">school.lesson.kanban</field>
            <field name="model">school.lesson</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="state"/>
                    <field name="lesson_type"/>
                    <field name="students_viewed"/>
                    <field name="students_total"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_card oe_kanban_global_click p-2">
                                <strong><field name="name"/></strong>
                                <div>
                                    <field name="class_id"/> - <field name="subject_id"/>
                                </div>
                                <div>
                                    <span class="badge badge-pill"
                                          t-attf-class="badge-#{record.state.raw_value == 'published' ? 'success' : 'secondary'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div t-if="record.state.raw_value == 'published'">
                                    شاهدوا: <field name="students_viewed"/> / <field name="students_total"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ==================== Search View ==================== -->
        <record id="view_school_lesson_search" model="ir.ui.view">
            <field name="name">school.lesson.search</field>
            <field name="model">school.lesson</field>
            <field name="arch" type="xml">
                <search string="بحث في الحصص">
                    <field name="name"/>
                    <field name="class_id"/>
                    <field name="subject_id"/>
                    <field name="teacher_id"/>
                    <filter string="مسودة" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="منشورة" name="published" domain="[('state','=','published')]"/>
                    <group expand="0" string="تجميع حسب">
                        <filter string="الفصل" name="group_class" context="{'group_by':'class_id'}"/>
                        <filter string="المادة" name="group_subject" context="{'group_by':'subject_id'}"/>
                        <filter string="الأستاذ" name="group_teacher" context="{'group_by':'teacher_id'}"/>
                        <filter string="الحالة" name="group_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ==================== View Log List (لمين شاف الحصة) ==================== -->
        <record id="view_school_lesson_view_log_list" model="ir.ui.view">
            <field name="name">school.lesson.view.log.list</field>
            <field name="model">school.lesson.view.log</field>
            <field name="arch" type="xml">
                <list string="سجل المشاهدة" create="false" edit="false">
                    <field name="student_id"/>
                    <field name="view_date"/>
                </list>
            </field>
        </record>

        <!-- ==================== Action + Menu ==================== -->
        <record id="action_school_lesson" model="ir.actions.act_window">
            <field name="name">الحصص الدراسية</field>
            <field name="res_model">school.lesson</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_school_lesson_search"/>
            <field name="context">{'search_default_published': 0}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    ابدأ برفع أول حصة دراسية
                </p>
            </field>
        </record>

        <menuitem id="menu_school_lessons_root" name="الحصص الدراسية"
                  sequence="15"/>
        <menuitem id="menu_school_lessons_main" name="الحصص"
                  parent="menu_school_lessons_root"
                  action="action_school_lesson" sequence="10"/>

    </data>
</odoo>

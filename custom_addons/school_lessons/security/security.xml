<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ==================== Groups ==================== -->
        <record id="group_school_teacher" model="res.groups">
            <field name="name">أستاذ (رفع الحصص)</field>
            <field name="category_id" ref="base.module_category_education"/>
        </record>

        <record id="group_school_lessons_manager" model="res.groups">
            <field name="name">مدير الحصص الدراسية</field>
            <field name="category_id" ref="base.module_category_education"/>
            <field name="implied_ids" eval="[(4, ref('group_school_teacher'))]"/>
        </record>

        <!-- ==================== Record Rules ==================== -->

        <!-- الأستاذ يشوف/يعدّل حصصه هو بس -->
        <record id="rule_lesson_teacher_own" model="ir.rule">
            <field name="name">حصص الأستاذ نفسه فقط</field>
            <field name="model_id" ref="model_school_lesson"/>
            <field name="domain_force">[('teacher_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_school_teacher'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- مدير الحصص يشوف كل الحصص -->
        <record id="rule_lesson_manager_all" model="ir.rule">
            <field name="name">كل الحصص لمدير الحصص</field>
            <field name="model_id" ref="model_school_lesson"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_school_lessons_manager'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- دفاع إضافي: مستخدم البورتال (الطالب) يشوف بس الحصص المنشورة لفصله -->
        <!-- (الوصول الفعلي بيتم عن طريق الكنترولر، والقاعدة دي طبقة حماية إضافية) -->
        <record id="rule_lesson_portal_own_class" model="ir.rule">
            <field name="name">حصص فصل الطالب المنشورة فقط - بورتال</field>
            <field name="model_id" ref="model_school_lesson"/>
            <field name="domain_force">
                [('state', '=', 'published')]
                 <!-- ('class_id.student_ids.partner_id', '=', user.partner_id.id) -->
            
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_financial_report_wizard"
            model="ir.ui.view">

        <field name="name">school.financial.report.wizard.form</field>

        <field name="model">school.financial.report.wizard</field>

        <field name="arch" type="xml">

            <form string="التقرير المالي">

                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>

                    <button
                        name="action_print_report"
                        type="object"
                        string="طباعة التقرير"
                        class="btn-primary"
                    />

                    <button
                        string="إلغاء"
                        special="cancel"
                    />

                </footer>

            </form>

        </field>

    </record>


    <record id="action_school_financial_report_wizard"
            model="ir.actions.act_window">

        <field name="name">التقرير المالي</field>
        <field name="res_model">school.financial.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

</odoo>
<odoo>

<template id="receipt_template">
<t t-call="web.external_layout">

 <main class="page" >  

<head>  
                <style>                 
                    @font-face {
                        font-family: 'Cairo-Bold';
                        src: url(/insurance_reports_custom/static/src/fonts/Cairo-VariableFont_slnt,wght.ttf);
                    }
                    body, table, div, span {
                        font-family: 'Cairo-Bold' !important;
                        direction: rtl;
                    }
                    td {
                        text-align :right;
                    }
                    img{
                        border: none !important;
                        box-shadow: none !important;
                        outlie: none !important;
                    }  
                </style> 
            </head>
<t t-call="web.html_container">

<t t-foreach="docs" t-as="o">

<t t-foreach="['نسخة الطالب','نسخة المدرسة']" t-as="copy">

<div style=" 
    padding:5px;
    direction:rtl; 
    border:1px solid black; 

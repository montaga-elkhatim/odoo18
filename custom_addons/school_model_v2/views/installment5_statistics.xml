<odoo>
    <!-- Action -->
    <record id="action_installment5_statistics" model="ir.actions.act_window">
        <field name="name">Installment 5 Statistics</field>
        <field name="res_model">student</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- فلترة مبدئية على القسط الأول -->
        <field name="domain">[('installment5_paid','>','0')]</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_installment5_statistics" 
              name="Installment 5 Statistics"
              parent="installment_statistics"
              action="action_installment5_statistics"
              sequence="90"/>

    <!-- Pivot View -->
    <record id="view_installment5_pivot" model="ir.ui.view">
        <field name="name">payment.installment5.pivot</field>
        <field name="model">student</field>
        <field name="arch" type="xml">
            <pivot string="Installment 5 Statistics">
                <field name="total_fees" type="measure"/>
                <field name="installment5_paid" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="remaining_fees" type="measure"/> 
                <field name="grade" type="row" string="Class"/>
                <field name="class_section" type="row" string="Section"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_installment5_graph" model="ir.ui.view">
        <field name="name">payment.installment5.graph</field>
        <field name="model">student</field>
        <field name="arch" type="xml">
            <graph string="Installment 5 Graph" type="bar">
                <field name="total_paid" type="measure"/>
                <field name="grade" type="row" string="Class"/>
                <field name="installment5_paid" type="measure"/>    
                <field name="class_section" type="row" string="Section"/>
            </graph>
        </field>
    </record>
</odoo>

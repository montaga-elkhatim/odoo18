<odoo>
    <!-- Action -->
    <record id="action_daily_expenditures_statistics" model="ir.actions.act_window">
        <field name="name">daily expenditures Statistics</field>
        <field name="res_model">school.expense</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- فلترة مبدئية على القسط الأول -->
        <field name="domain">[('category','=','dayle_expense')]</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_daily_expenditures_statistics" 
              name="daily expenditures Statistics"
              parent="expenses_statistics"
              action="action_daily_expenditures_statistics"
               />

    <!-- Pivot View -->
    <record id="view_daily_expenditures_pivot" model="ir.ui.view">
        <field name="name">daily.expenditures.pivot</field>
        <field name="model">school.expense</field>
        <field name="arch" type="xml">
            <pivot string="daily expenditures Statistics">
                <field name="amount" type="measure"/>  
                <field name="purpose" type="row" string="expense_type"/> 
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_daily_expenditures_graph" model="ir.ui.view">
        <field name="name">payment.daily.expenditures.graph</field>
        <field name="model">school.expense</field>
        <field name="arch" type="xml">
            <graph string="daily expenditures Graph" type="bar">
                <field name="amount" type="measure"/>  
                <field name="purpose" type="row" string="expense_type"/> 
            </graph>
        </field>
    </record>
</odoo>

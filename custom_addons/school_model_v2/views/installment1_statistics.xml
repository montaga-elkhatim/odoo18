<odoo>
    <!-- Action -->
    <record id="action_installment1_statistics" model="ir.actions.act_window">
        <field name="name">Installment 1 Statistics</field>
        <field name="res_model">student</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- فلترة مبدئية على القسط الأول -->
        <field name="domain">[('installment1_paid','>','0')]</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_installment1_statistics" 
              name="Installment 1 Statistics"
              parent="installment_statistics"
              action="action_installment1_statistics"
              sequence="90"/>

    <!-- Pivot View -->
    <record id="view_installment1_pivot" model="ir.ui.view">
        <field name="name">payment.installment1.pivot</field>
        <field name="model">student</field>
        <field name="arch" type="xml">
            <pivot string="Installment 1 Statistics">
                <field name="total_fees" type="measure"/>
                <field name="installment1_paid" type="measure"/>
                <field name="total_paid" type="measure"/>
                <field name="remaining_fees" type="measure"/> 
                <field name="grade" type="row" string="Class"/>
                <field name="class_section" type="row" string="Section"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_installment1_graph" model="ir.ui.view">
        <field name="name">payment.installment1.graph</field>
        <field name="model">student</field>
        <field name="arch" type="xml">
            <graph string="Installment 1 Graph" type="bar">
                <field name="total_paid" type="measure"/>
                <field name="grade" type="row" string="Class"/>
                <field name="installment1_paid" type="measure"/>    
                <field name="class_section" type="row" string="Section"/>
            </graph>
        </field>
    </record>
</odoo>

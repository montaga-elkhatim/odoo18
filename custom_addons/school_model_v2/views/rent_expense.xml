<odoo>
    <!-- Action -->
    <record id="action_school_expense_rent_statistics" model="ir.actions.act_window">
        <field name="name">rent salary Statistics</field>
        <field name="res_model">school.expense</field>
        <field name="view_mode">pivot,graph,list</field>
        <!-- فلترة مبدئية على القسط الأول --> 
        <field name="domain">[('category','=','rent')]</field>

    </record>

    <!-- Menu Item -->
    <menuitem id="menu_school_expense_rent_statistics" 
              name="rent salary Statistics"
              parent="expenses_statistics"
              action="action_school_expense_rent_statistics"
               />

    <!-- Pivot View -->
    <record id="view_school_expense_rent_pivot" model="ir.ui.view">
        <field name="name">daily.expenditures.pivot</field>
        <field name="model">school.expense</field>
        <field name="arch" type="xml">
            <pivot string="rent salary Statistics">
                <field name="amount" type="measure"/>   
                <field name="owner" type="row" string="rent name"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_school_expense_rent_graph" model="ir.ui.view">
        <field name="name">payment.daily.expenditures.graph</field>
        <field name="model">school.expense</field>
        <field name="arch" type="xml">
            <graph string="rent salary Graph" type="bar">
                <field name="amount" type="measure"/>   
                <field name="owner" type="row" string="rent name"/>
                
            </graph>
        </field>
    </record>
</odoo>
